# Copy to android/key.properties and fill in for release signing.
# Generate a keystore once with:
#   keytool -genkey -v -keystore ~/isdb-radio-upload.jks \
#     -keyalg RSA -keysize 2048 -validity 10000 -alias upload
# Never commit key.properties or the .jks file.
storePassword=CHANGE_ME
keyPassword=CHANGE_ME
keyAlias=upload
storeFile=/absolute/path/to/isdb-radio-upload.jks
